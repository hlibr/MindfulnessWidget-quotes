  "quotes": [
    {
      "id": "q_zzzz000000",
      "text": "Notice your nose.\nAnything else you’re ignoring right now?"
    },
    {
      "id": "q_zzzz000002",
      "text": "Now you’re reading, now you’re not"
    },
    {
      "id": "q_zzzz00001e",
      "text": "Do you like this quote?"
    },
    {
      "id": "q_zzzz000003",
      "text": "Shed your ego like geckos their skin"
    },
    {
      "id": "q_zzzz00014y",
      "text": "It's now o'clock."
    },
    {
      "id": "q_zzzz0000gj",
      "text": "This phone never changes its place — the universe moves around it"
    },
    {
      "id": "q_zzzz0003ng",
      "text": "Accept your current limitations. Strive to be limitless"
    },
    {
      "id": "q_zzzz000fgm",
      "text": "This is happening now"
    },
    {
      "id": "q_zzzz002abl",
      "text": "You’re still the same"
    },
    {
      "id": "q_zzzz0023n9",
      "text": "This is your moment"
    },
    {
      "id": "q_zzzz000gww",
      "text": "Now"
    },
    {
      "id": "q_zzzz00encv",
      "text": "Learn to see through hate"
    },
    {
      "id": "q_zzzz00ayxb",
      "text": "This is your life"
    },
    {
      "id": "q_zzzz001u9h",
      "text": "This is right now"
    },
    {
      "id": "q_zzzz001mus",
      "text": "You're not alone"
    },
    {
      "id": "q_zzzz0033lc",
      "text": "Everything is here"
    },
    {
      "id": "q_zzzz0058k5",
      "text": "You are here now"
    },
    {
      "id": "q_zzzz000zwn",
      "text": "Just be here"
    },
    {
      "id": "q_zzzz00049j",
      "text": "Everybody lives in this present moment - isn't that weird?"
    },
    {
      "id": "q_zzzz00267i",
      "text": "Lucidity comes from stillness"
    },
    {
      "id": "q_zzzz002uez",
      "text": "Ride the moment"
    },
    {
      "id": "q_zzzz00002q",
      "text": "Let the wind decide"
    },
    {
      "id": "q_zzzz000hvm",
      "text": "Do or don’t - it’s fine"
    },
    {
      "id": "q_zzzz000q2w",
      "text": "Answers are within you"
    },
    {
      "id": "q_zzzz0002mb",
      "text": "This is now"
    },
    {
      "id": "q_zzzz000bsr",
      "text": "Respect your own pain"
    },
    {
      "id": "q_zzzz0005e6",
      "text": "Nothing is unchanging"
    },
    {
      "id": "q_zzzz0004oj",
      "text": "Where are you coming from?"
    },
    {
      "id": "q_zzzz00a2rj",
      "text": "Be here"
    },
    {
      "id": "q_zzzz0002n7",
      "text": "It’s always happening now"
    },
    {
      "id": "q_zzzz009kct",
      "text": "We all come from nowhere, and nowhere we go"
    },
    {
      "id": "q_zzzz000156",
      "text": "You matter"
    },
    {
      "id": "q_zzzz000621",
      "text": "We're all here"
    }
  ]
}